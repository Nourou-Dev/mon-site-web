# ==============================================================================
# CONFIGURATION BASE DE DONNÉES POSTGRESQL (NEON / VERCEL POSTGRES / SUPABASE)
# ==============================================================================

# Clé secrète de secours pour l'administrateur
ADMIN_SECRET_KEY="nourou_admin_secret_2026!"

# Sur Vercel : activez l'onglet "Storage" -> "Postgres" (propulsé par Neon).
# Ces variables sont ensuite injectées AUTOMATIQUEMENT par Vercel !

# 1. URL de connexion avec Pooler (PgBouncer) pour les fonctions Serverless
POSTGRES_PRISMA_URL="postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# 2. URL de connexion directe (pour les migrations schema Prisma)
POSTGRES_URL_NON_POOLING="postgresql://user:password@ep-sample.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# 3. URL standard de fallback
DATABASE_URL="postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
